<Window x:Class="UmiClassGuardLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Umi ClassGuard Lite" Width="1180" Height="795" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0B1422" Foreground="#EBF3FC"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#152236"/>
        <SolidColorBrush x:Key="Surface2" Color="#1C2B40"/>
        <SolidColorBrush x:Key="Accent" Color="#75C6B6"/>
        <SolidColorBrush x:Key="Muted" Color="#9AAEC4"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#253750"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5D3E5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#24374E"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#75C6B6"/>
            <Setter Property="Foreground" Value="#0C2330"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.84"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#27394E"/>
            <Setter Property="Foreground" Value="#EAF2FC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1A2B"/>
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="CaretBrush" Value="#75C6B6"/>
            <Setter Property="BorderBrush" Value="#344660"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4EFFB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#14243B"/>
            <Setter Property="Foreground" Value="#16263B"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="37"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F7FD"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Subheading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F6FD"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99AEC5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="231"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#101B2B" BorderBrush="#25334A" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,26,12,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="43" Height="43" CornerRadius="12" Background="#75C6B6">
                            <TextBlock Text="CG" Foreground="#102638" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,2,0,0">
                            <TextBlock Text="CLASSGUARD" FontWeight="Bold" FontSize="16" Foreground="#F0F6FE"/>
                            <TextBlock Text="Lite  ·  Standard User" Foreground="#92A7BD" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,15,20,26">
                    <Border Background="#1B2D40" CornerRadius="9" Padding="13,11">
                        <StackPanel>
                            <TextBlock Text="NO-ADMIN EDITION" Foreground="#75C6B6" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Không thể khóa Windows tuyệt đối" TextWrapping="Wrap" Foreground="#A8B8CC" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Margin="9,12,9,0">
                    <TextBlock Text="QUẢN LÝ" Foreground="#687F9A" FontSize="11" FontWeight="Bold" Margin="25,0,0,13"/>
                    <Button x:Name="NavOverview" Style="{StaticResource SidebarButton}" Background="#243B49" Foreground="#9BE1D3" Click="Overview_Click" Content="▣    Tổng quan"/>
                    <Button x:Name="NavApps" Style="{StaticResource SidebarButton}" Click="Apps_Click" Content="▤    Ứng dụng"/>
                    <Button x:Name="NavWeb" Style="{StaticResource SidebarButton}" Click="Web_Click" Content="◎    Website"/>
                    <Button x:Name="NavLogs" Style="{StaticResource SidebarButton}" Click="Logs_Click" Content="◷    Nhật ký"/>
                    <Button x:Name="NavSettings" Style="{StaticResource SidebarButton}" Click="Settings_Click" Content="⚙    Cài đặt"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
            <Border BorderBrush="#26354C" BorderThickness="0,0,0,1" Padding="32,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#75C6B6" Margin="0,0,9,0"/>
                        <TextBlock Text="LOCAL PROTECTION" Foreground="#AFC3D5" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Umi ClassGuard · Windows 10/11" Foreground="#7389A4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,28,32,22">
                    <StackPanel x:Name="OverviewPanel">
                        <TextBlock Text="Tổng quan lớp học" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Kiểm soát ứng dụng trong phạm vi quyền User. Không cài service hay extension." Style="{StaticResource Note}" Margin="0,0,0,23"/>
                        <Border Style="{StaticResource Card}" Padding="23">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TRẠNG THÁI PHIÊN HỌC" Foreground="#8FA9C0" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FocusStatusText" Text="Chưa bật Focus Mode" FontSize="24" FontWeight="SemiBold" Foreground="#F1F7FB" Margin="0,14,0,5"/>
                                    <TextBlock x:Name="FocusDetailText" Text="Hệ thống đang ở chế độ giám sát, không tự đóng game." Style="{StaticResource Note}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1B3440" Padding="16" CornerRadius="12" Margin="16,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CÒN LẠI" FontSize="11" Foreground="#8DDCCF" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RemainingText" Text="--:--" FontSize="29" FontWeight="Bold" Foreground="#E8FFF6" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="TIẾN TRÌNH BỊ NHẬN DIỆN" Style="{StaticResource Note}" FontSize="11"/>
                                    <TextBlock x:Name="DetectedCountText" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <TextBlock Text="Trong phiên ứng dụng hiện tại" Style="{StaticResource Note}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Text="QUY TẮC ỨNG DỤNG" Style="{StaticResource Note}" FontSize="11"/>
                                    <TextBlock x:Name="RuleCountText" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <TextBlock Text="Quy tắc đang được bật" Style="{StaticResource Note}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Bắt đầu tiết học" Style="{StaticResource Subheading}"/>
                                <TextBlock Text="Focus Mode sẽ hết hạn tự động. Mặc định chỉ ghi nhận; bật Auto Close riêng trong mục Ứng dụng." Style="{StaticResource Note}" Margin="0,9,0,18"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lớp" VerticalAlignment="Center" Margin="0,0,11,0" Foreground="#A9BED1"/>
                                    <ComboBox x:Name="ProfileCombo" Width="173" SelectionChanged="ProfileChanged">
                                        <ComboBoxItem Content="Python"/>
                                        <ComboBoxItem Content="Scratch"/>
                                        <ComboBoxItem Content="Roblox Studio"/>
                                        <ComboBoxItem Content="Giờ kiểm tra"/>
                                    </ComboBox>
                                    <TextBlock Text="Phút" VerticalAlignment="Center" Margin="18,0,10,0" Foreground="#A9BED1"/>
                                    <TextBox x:Name="MinutesTextBox" Width="65" Text="90"/>
                                    <Button Content="Bắt đầu Focus" Style="{StaticResource PrimaryButton}" Margin="18,0,9,0" Click="StartFocus_Click"/>
                                    <Button Content="Dừng" Style="{StaticResource GhostButton}" Click="StopFocus_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Giới hạn cần biết" Style="{StaticResource Subheading}" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Note}" Text="• Chỉ phát hiện và đóng chương trình cùng phiên User khi Windows cho phép.&#x0a;• Không thể ngăn học sinh tắt ClassGuard bằng Task Manager.&#x0a;• Chặn website là tùy chọn thử nghiệm theo chính sách trình duyệt, không phải tường lửa."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="AppsPanel" Visibility="Collapsed">
                        <TextBlock Text="Quản lý ứng dụng" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Note}" Text="Nhận diện bằng tên tiến trình. Chỉ thử đóng cửa sổ, không buộc dừng tiến trình nền." Margin="0,0,0,23"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Chế độ xử lý" Style="{StaticResource Subheading}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="AutoCloseCheckBox" Content="Auto Close - tự yêu cầu đóng cửa sổ ứng dụng bị hạn chế khi Focus đang bật" Checked="AutoCloseChanged" Unchecked="AutoCloseChanged" Padding="0,5"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" Text="Nếu ứng dụng không có cửa sổ hoặc từ chối đóng, ClassGuard chỉ ghi log. Không tự chạy thao tác Kill cưỡng bức."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Danh sách theo dõi" Style="{StaticResource Subheading}" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="RulesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#29384B" BorderThickness="0,0,0,1" Padding="2,12">
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Content="Xóa" Tag="{Binding}" Click="DeleteRule_Click" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"/>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Click="RuleChanged_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="#93A9BF" FontSize="12" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Thêm ứng dụng theo dõi" Style="{StaticResource Subheading}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <TextBox x:Name="RuleNameInput" Width="190" Margin="0,0,10,0" ToolTip="Tên dễ đọc, ví dụ: Game ABC"/>
                                    <TextBox x:Name="ProcessNameInput" Width="180" Margin="0,0,10,0" ToolTip="Tên tiến trình trong Task Manager, ví dụ: game.exe"/>
                                    <Button Content="+ Thêm quy tắc" Style="{StaticResource PrimaryButton}" Click="AddRule_Click"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,11,0,0" Text="Cần nhập tên hiển thị và tên tiến trình. Ví dụ: Roblox Player / RobloxPlayerBeta.exe"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="WebPanel" Visibility="Collapsed">
                        <TextBlock Text="Website Guard" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Note}" Text="Không dùng extension. Có thể thử áp dụng HKCU URLBlocklist cho Edge/Chrome; hiệu lực còn phụ thuộc chính sách trường." Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Background="#3B3026" Padding="13" CornerRadius="8" Margin="0,0,0,16">
                                    <TextBlock Foreground="#F6C996" TextWrapping="Wrap" Text="THỬ NGHIỆM - Ghi Registry không đồng nghĩa đã chặn website. Quy tắc tồn tại sau khi kết thúc Focus đến khi được khôi phục thủ công. Cần khởi động lại trình duyệt, mở edge://policy hoặc chrome://policy và kiểm tra URL. Firefox, Opera, Brave không được bảo đảm."/>
                                </Border>
                                <TextBlock Text="Tên miền cần hạn chế (mỗi dòng một tên miền)" Style="{StaticResource Subheading}" Margin="0,0,0,10"/>
                                <TextBox x:Name="DomainTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="205" FontFamily="Consolas" FontSize="13"/>
                                <WrapPanel Margin="0,15,0,0">
                                    <Button Content="Áp dụng thử trên Edge / Chrome" Style="{StaticResource PrimaryButton}" Click="ApplyWeb_Click" Margin="0,0,10,0"/>
                                    <Button Content="Khôi phục chính sách của app" Style="{StaticResource GhostButton}" Click="RestoreWeb_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="WebResultText" Style="{StaticResource Note}" Margin="0,14,0,0" Text="Chưa áp dụng chính sách trình duyệt."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tương thích thực tế" Style="{StaticResource Subheading}" Margin="0,0,0,11"/>
                                <TextBlock Style="{StaticResource Note}" Text="Edge / Chrome  ·  Có điều kiện, phải xác minh bằng thao tác thật&#x0a;Firefox / Brave / Opera  ·  Chưa hỗ trợ chặn URL trong bản Lite&#x0a;Ẩn danh / VPN / DNS / USB portable  ·  Không có bảo vệ toàn hệ thống"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="LogsPanel" Visibility="Collapsed">
                        <TextBlock Text="Nhật ký hoạt động" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Note}" Text="Sự kiện chỉ được ghi trong phạm vi ClassGuard đang chạy. Log nằm trong tài khoản User và có thể bị xóa." Margin="0,0,0,20"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource GhostButton}" Click="RefreshLog_Click"/>
                                    <TextBlock Text="100 sự kiện gần nhất" Style="{StaticResource Subheading}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="ActivityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2A3A4C" BorderThickness="0,0,0,1" Padding="0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="#AABBD0" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding Time}" Foreground="#70869E" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Không thu thập nội dung chat, phím gõ, mật khẩu hoặc lịch sử duyệt web." Style="{StaticResource Note}" Margin="0,14,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="Cài đặt ứng dụng" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Cấu hình cho tài khoản Windows hiện tại, không can thiệp hệ thống." Style="{StaticResource Note}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Khởi động và dữ liệu" Style="{StaticResource Subheading}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="StartupCheckBox" Content="Tự chạy ClassGuard khi tôi đăng nhập Windows" Margin="0,0,0,11"/>
                                <TextBlock Style="{StaticResource Note}" Text="Sử dụng HKCU Run, không cần Admin. Windows hoặc chính sách của trường có thể từ chối." Margin="0,0,0,16"/>
                                <Button Content="Lưu cài đặt" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                                <TextBlock x:Name="SettingsResultText" Style="{StaticResource Note}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Thông tin kỹ thuật" Style="{StaticResource Subheading}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TechnicalText" Style="{StaticResource Note}" TextWrapping="Wrap"/>
                                <Button Content="Mở thư mục dữ liệu" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OpenData_Click" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Chẩn đoán và mã lỗi" Style="{StaticResource Subheading}" Margin="0,0,0,8"/>
                                <TextBlock Text="Nếu có lỗi trên máy trường, chỉ cần gửi mã CG-xxxx hoặc báo cáo này để hỗ trợ." Style="{StaticResource Note}" Margin="0,0,0,12"/>
                                <Border Background="#20374A" CornerRadius="8" Padding="11" Margin="0,0,0,14">
                                    <DockPanel>
                                        <TextBlock x:Name="LastErrorCodeText" Text="CG-0000" FontWeight="Bold" Foreground="#91E4D1" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="LastErrorDetailText" Text="Chưa có lỗi được ghi nhận." TextWrapping="Wrap" Foreground="#CAD8E8"/>
                                    </DockPanel>
                                </Border>
                                <WrapPanel Margin="0,0,0,14">
                                    <Button Content="Tự kiểm tra máy" Style="{StaticResource PrimaryButton}" Click="RunDiagnostics_Click" Margin="0,0,9,8"/>
                                    <Button Content="Sao chép báo cáo" Style="{StaticResource GhostButton}" Click="CopyDiagnostics_Click" Margin="0,0,9,8"/>
                                    <Button Content="Xuất file báo cáo" Style="{StaticResource GhostButton}" Click="ExportDiagnostics_Click" Margin="0,0,9,8"/>
                                </WrapPanel>
                                <TextBox x:Name="DiagnosticReportBox" Height="224" TextWrapping="NoWrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Style="{StaticResource Note}" Text="Không ghi mật khẩu, cookie, nội dung chat hoặc lịch sử duyệt web. Nếu EXE bị Windows chặn trước khi chạy, ứng dụng không thể tự hiện mã lỗi." Margin="0,11,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#101A29" BorderBrush="#26354C" BorderThickness="0,1,0,0" Padding="32,0">
                <Grid>
                    <TextBlock Text="ClassGuard Lite 1.0.1  ·  Chế độ User  ·  Không chạy service nền" Foreground="#879CB5" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterStatus" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8DCFC1" FontSize="11" Text="Sẵn sàng"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
